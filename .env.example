# Copie para .env e preencha. O .env não vai para o git.
EMAIL_DESTINO=seu-email@gmail.com

# Opção 1 - Resend (use no Render: o plano gratuito bloqueia SMTP).
# Crie a chave em https://resend.com/api-keys. Sem domínio próprio,
# o Resend só entrega para o e-mail da sua conta Resend.
RESEND_API_KEY=
# EMAIL_REMETENTE=Portfólio <onboarding@resend.dev>

# Opção 2 - SMTP (usado quando RESEND_API_KEY está vazio).
# Gmail: use uma "senha de app" (https://myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=seu-email@gmail.com
SMTP_SENHA=sua-senha-de-app
